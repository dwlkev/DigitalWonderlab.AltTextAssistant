<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- NuGet metadata -->
		<IsPackable>true</IsPackable>
		<PackageId>DigitalWonderlab.AltTextAssistant</PackageId>
		<Version>1.0.0</Version>
		<Authors>Digital Wonderlab</Authors>
		<Company>Digital Wonderlab</Company>
		<Description>Find and fix images missing alt text in Umbraco 17+. Adds a Media section dashboard that lists every image with no alt text, with one-click AI suggestions (Anthropic Claude, OpenAI, or Google Gemini vision) and bulk-suggest across the page. Bring your own API key. Works on Umbraco Cloud and all hosting environments.</Description>
		<PackageTags>umbraco;umbraco-cms;umbraco-marketplace;accessibility;alt-text;a11y;ai;seo;media</PackageTags>
		<RepositoryUrl>https://github.com/dwlkev/DigitalWonderlab.AltTextAssistant</RepositoryUrl>
		<PackageProjectUrl>https://github.com/dwlkev/DigitalWonderlab.AltTextAssistant</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Key for Umbraco App_Plugins packing -->
		<ContentTargetFolders>content</ContentTargetFolders>
		<IncludeBuildOutput>true</IncludeBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,19.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0,19.0.0)" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0,19.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Pack App_Plugins as content -->
	<ItemGroup>
		<Content Include="App_Plugins\AltTextAssistant\**" ExcludeFromSingleFile="true">
			<Pack>true</Pack>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- Pack .targets to buildTransitive (Umbraco standard for copy on build) -->
		<None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>

	<!-- README + icon -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Auto cache-bust: stamp PACKAGE_VERSION token with actual version at build, restore after -->
	<Target Name="StampCacheBuster" BeforeTargets="BeforeBuild">
		<Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\build\stamp-version.ps1&quot; -Version $(Version) -PluginDir &quot;$(MSBuildProjectDirectory)\App_Plugins\AltTextAssistant&quot;" />
	</Target>
	<Target Name="RestoreCacheBusterToken" AfterTargets="AfterBuild;Pack">
		<Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\build\stamp-version.ps1&quot; -Version $(Version) -PluginDir &quot;$(MSBuildProjectDirectory)\App_Plugins\AltTextAssistant&quot; -Restore" />
	</Target>

	<!-- Exclude non-shipping folders from MSBuild globbing -->
	<ItemGroup>
		<None Remove="screenshots\**" />
		<Content Remove="screenshots\**" />
	</ItemGroup>

</Project>
